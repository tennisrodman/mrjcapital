{
  "lifecycle": {
    "pipeline_transitions": {
      "sourced": ["screening", "on_hold", "dead"],
      "screening": ["quoting", "on_hold", "dead"],
      "quoting": ["negotiating", "on_hold", "dead"],
      "negotiating": ["signed", "quoting", "on_hold", "dead"],
      "signed": ["closing", "quoting", "on_hold", "dead"],
      "closing": ["closed", "negotiating", "quoting", "on_hold", "dead"],
      "closed": ["servicing"],
      "servicing": ["exited"],
      "on_hold": [],
      "dead": [],
      "exited": []
    },
    "syndication_transitions": {
      "not_started": ["raising"],
      "raising": ["fully_subscribed", "cancelled"],
      "fully_subscribed": ["closed", "cancelled"],
      "closed": [],
      "cancelled": []
    }
  },
  "document_upload": {
    "default_max_bytes": 52428800,
    "allowed_file_types": [
      "csv",
      "docx",
      "jpeg",
      "jpg",
      "pdf",
      "png",
      "txt",
      "xls",
      "xlsx",
      "zip"
    ],
    "allowed_categories": [
      "appraisal",
      "closing_docs",
      "construction",
      "correspondence",
      "entity_docs",
      "environmental",
      "financials",
      "insurance",
      "investor_docs",
      "legal",
      "offering_memo",
      "other",
      "rent_roll",
      "servicing",
      "title"
    ],
    "allowed_visibility_roles": ["borrower", "counsel", "internal", "investor"],
    "cases": [
      {
        "name": "normalizes an uppercase PDF extension",
        "file_type": "PDF",
        "file_size_bytes": 1024,
        "valid": true,
        "expected_file_type": "pdf",
        "expected_content_type": "application/pdf"
      },
      {
        "name": "normalizes a leading-dot CSV extension",
        "file_type": ".csv",
        "file_size_bytes": 2048,
        "valid": true,
        "expected_file_type": "csv",
        "expected_content_type": "text/csv"
      },
      {
        "name": "rejects an unsupported executable extension",
        "file_type": "exe",
        "file_size_bytes": 1024,
        "valid": false,
        "error_field": "file_type",
        "error_message": "Unsupported file type: exe"
      },
      {
        "name": "rejects an empty file",
        "file_type": "pdf",
        "file_size_bytes": 0,
        "valid": false,
        "error_field": "file_size_bytes",
        "error_message": "Ensure this value is greater than or equal to 1."
      },
      {
        "name": "rejects a file above the default 50 MB limit",
        "file_type": "pdf",
        "file_size_bytes": 52428801,
        "valid": false,
        "error_field": "file_size_bytes",
        "error_message": "File exceeds maximum upload size of 52428800 bytes."
      },
      {
        "name": "rejects an unknown document category",
        "file_type": "pdf",
        "file_size_bytes": 1024,
        "category": "unknown_category",
        "valid": false,
        "error_field": "category",
        "error_message": "\"unknown_category\" is not a valid choice."
      },
      {
        "name": "rejects an unknown visibility role",
        "file_type": "pdf",
        "file_size_bytes": 1024,
        "visibility_roles": ["public"],
        "valid": false,
        "error_field": "visibility_roles",
        "error_message": "Unsupported visibility role(s): public"
      }
    ]
  }
}
